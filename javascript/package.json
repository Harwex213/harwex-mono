{
  "name": "to-the-frontend-moon",
  "private": true,
  "type": "module",
  "scripts": {
    ":excalidraw-markdown": "EXCALIDRAW_CONVERT_CWD=$INIT_CWD yarn workspace @hw/excalidraw-convert markdown",
    ":rr": "npx rimraf@4.4.1",
    ":sap-parse": "SAP_PARSE_CWD=$INIT_CWD yarn workspace @hw/scratchapixel-parser parse",
    ":static": "yarn http-server $INIT_CWD -p 0 -c-1",
    ":vk-parse": "VK_PARSE_CWD=$INIT_CWD yarn workspace @hw/faenwald-parser parse",
    "force": "yarn :rr **/node_modules && yarn"
  },
  "devDependencies": {
    "http-server": "14.1.1",
    "process": "^0.11.10"
  },
  "workspaces": {
    "packages": [
      "packages/**/*"
    ]
  },
  "resolutions": {
    "@types/react": "npm:@types/react@19.2.0",
    "@types/react-dom": "npm:@types/react-dom@19.2.0",
    "@types/pixi.js": "npm:@types/pixi.js@5.0.0"
  },
  "packageManager": "yarn@4.1.1"
}

{
  "name": "@hw/civitas-interactive-map",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve",
    "build": "rspack build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:screenshots": "rspack build -c e2e/rspack.config.mjs && playwright test -c e2e/playwright.config.ts",
    "test:screenshots:update": "rspack build -c e2e/rspack.config.mjs && playwright test -c e2e/playwright.config.ts --update-snapshots"
  },
  "dependencies": {
    "@preact/signals-react": "3.9.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@rspack/cli": "2.1.4",
    "@rspack/core": "2.1.4",
    "@rspack/dev-server": "2.1.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "tsx": "4.19.4",
    "typescript": "5.9.3"
  },
  "browserslist": [
    "last 1 version",
    "> 1%",
    "not dead"
  ]
}

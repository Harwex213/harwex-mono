{
  "name": "@hw/modelgen-harness",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/electron/main.js",
  "browserslist": [
    "last 1 chrome version"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",

    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.185.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@hw/typescript-config": "workspace:*",
    "@rspack/cli": "2.1.4",
    "@rspack/core": "2.1.4",
    "@rspack/dev-server": "2.1.0",
    "@types/node": "24.1.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/three": "0.185.4",
    "electron": "44.2.0",
    "typescript": "5.9.3"
  }

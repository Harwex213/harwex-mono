{
  "name": "@hw/harwex-notes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "browserslist": [
    "last 1 version",
    "> 1%",
    "not dead"
  ],
  "scripts": {
    "dev": "rspack serve",
    "dev:mocked": "rspack serve --env mocked",
    "build": "rspack build",
    "build:mocked": "rspack build --env mocked",
    "typecheck": "tsc --noEmit",
    "build:static": "node scripts/build-static.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@excalidraw/excalidraw": "0.18.1",
    "@hw/harwex-notes-components": "workspace:*",
    "@hw/harwex-notes-protocol": "workspace:*",
    "@preact/signals-react": "3.9.0",
    "@trpc/client": "11.18.0",
    "codemirror": "6.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@hw/typescript-config": "workspace:*",
    "@rspack/cli": "2.1.4",
    "@rspack/core": "2.1.4",
    "@rspack/dev-server": "2.1.0",
    "@types/node": "24.1.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.9.3"
  }
}

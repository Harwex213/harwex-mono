  },
  "dependencies": {
    "@hw/harwex-notes-protocol": "workspace:*",
    "@trpc/server": "11.18.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hw/typescript-config": "workspace:*",
    "@types/node": "24.1.0",
    "tsx": "4.19.4",
    "typescript": "5.9.3"
  }
}

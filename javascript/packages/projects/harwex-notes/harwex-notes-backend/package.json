{
  "name": "@hw/harwex-notes-backend",
  "description": "harwex-notes tRPC backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/router/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
